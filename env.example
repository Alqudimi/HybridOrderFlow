# =====================================================================
# Big Data Platform - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and adjust the variables as needed.
# DO NOT commit real secrets or production credentials into git.

# MongoDB Database Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=orders_pipeline

# ELT Pipeline & Batch Settings
SMALL_FILE_THRESHOLD_MB=200
BATCH_SIZE=1000
SMART_POLL_LEASE_SECONDS=300
RESULTS_PATH=reports/results.json

# Apache Spark Settings (for datasets > 200MB)
SPARK_MASTER=local[*]
SPARK_APP_NAME=hybrid-orders-pipeline
SPARK_PARTITIONS=4
SPARK_JARS=jars/mongo-spark-connector_2.13-10.4.0.jar
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g
SPARK_DEPLOY_MODE=client

# FastAPI Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
